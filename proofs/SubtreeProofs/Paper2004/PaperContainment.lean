module

public import SubtreeProofs.Paper2004.ContractionCompleteness
import Mathlib.Tactic

/-!
# Containment in the printed 2004 definition

Definition 2 of Lozano--Valiente (2004) says that `s` is contained in `t`
when the words coincide, or when `t = t1 + nest t2 + t3` and
`s = s1 + s2 + s3`, where each `si` is contained in `ti`.

This module records that literal recursive relation independently of
`DyckEmbeds` (the reflexive/transitive closure of deleting any matched
pair in an arbitrary balanced-word context).

The forward theorem below connects the literal definition to the existing
operational semantics. The converse should *not* be assumed: the two
relations differ on a three-edge example, recorded in the accompanying
independent executable check. In particular, changing this definition to
refer to `DyckEmbeds` would conceal the discrepancy.
-/

@[expose] public section

namespace SubtreeProofs.Paper2004
namespace OrderedTree

/-- The least relation generated by the two clauses of the *printed*
Definition 2 (Lozano--Valiente, 2004). The second clause always removes
one top-level pair of the larger word, while recursively shrinking the
three balanced pieces. It deliberately does not inherit the tree semantics. -/
inductive PrintedContains : DyckWord → DyckWord → Prop where
  | refl (word : DyckWord) : PrintedContains word word
  | remove (s1 s2 s3 t1 t2 t3 : DyckWord)
      (h1 : PrintedContains s1 t1)
      (h2 : PrintedContains s2 t2)
      (h3 : PrintedContains s3 t3) :
      PrintedContains (s1 + s2 + s3) (t1 + t2.nest + t3)

/-- The printed relation never increases the edge/semilength count. -/
theorem PrintedContains.semilength_le {small large : DyckWord}
    (h : PrintedContains small large) :
    small.semilength ≤ large.semilength := by
  induction h with
  | refl word => exact Nat.le_refl _
  | remove s1 s2 s3 t1 t2 t3 h1 h2 h3 ih1 ih2 ih3 =>
      simp only [DyckWord.semilength_add, DyckWord.semilength_nest]
      omega

/-- Equal semilength forces equality in the printed relation. Every
non-reflexive use of its second clause deletes at least one matched pair. -/
theorem PrintedContains.eq_of_semilength_eq {small large : DyckWord}
    (h : PrintedContains small large)
    (hLength : small.semilength = large.semilength) :
    small = large := by
  cases h with
  | refl word => rfl
  | remove s1 s2 s3 t1 t2 t3 h1 h2 h3 =>
      have hle1 := PrintedContains.semilength_le h1
      have hle2 := PrintedContains.semilength_le h2
      have hle3 := PrintedContains.semilength_le h3
      simp only [DyckWord.semilength_add, DyckWord.semilength_nest] at hLength
      omega

/-- Applying a Dyck context to both sides of a single pair deletion
preserves the deletion relation. -/
theorem dyckContractStep_context (ctx : DyckContext)
    {before after : DyckWord} (step : DyckContractStep before after) :
    DyckContractStep (ctx.plug before) (ctx.plug after) := by
  rcases step with ⟨inner, interior, hb, ha⟩
  refine ⟨ctx.compose inner, interior, ?_, ?_⟩
  · calc
      ctx.plug before = ctx.plug (inner.plug interior.nest) :=
        congrArg (ctx.plug) hb
      _ = (ctx.compose inner).plug interior.nest :=
        (DyckContext.plug_compose ctx inner interior.nest).symm
  · calc
      ctx.plug after = ctx.plug (inner.plug interior) :=
        congrArg (ctx.plug) ha
      _ = (ctx.compose inner).plug interior :=
        (DyckContext.plug_compose ctx inner interior).symm

/-- Dyck contraction closure is preserved by a surrounding context. -/
theorem dyckEmbeds_context (ctx : DyckContext)
    {small large : DyckWord} (h : DyckEmbeds small large) :
    DyckEmbeds (ctx.plug small) (ctx.plug large) := by
  unfold DyckEmbeds at h ⊢
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hprefix hstep ih =>
      exact Relation.ReflTransGen.trans ih
        (Relation.ReflTransGen.single (dyckContractStep_context ctx hstep))

/-- Transitivity in the `small, large` argument convention. -/
theorem dyckEmbeds_trans {a b c : DyckWord}
    (hab : DyckEmbeds a b) (hbc : DyckEmbeds b c) :
    DyckEmbeds a c :=
  Relation.ReflTransGen.trans hbc hab

/-- Dyck contractions in the left word preserve an appended right word. -/
theorem dyckEmbeds_append_right (suffix : DyckWord)
    {small large : DyckWord} (h : DyckEmbeds small large) :
    DyckEmbeds (small + suffix) (large + suffix) := by
  have lifted := dyckEmbeds_context
    (DyckContext.siblings 0 suffix DyckContext.hole) h
  simpa only [DyckContext.plug, zero_add] using lifted

/-- Dyck contractions in the right word preserve a prepended left word. -/
theorem dyckEmbeds_append_left (leftWords : DyckWord)
    {small large : DyckWord} (h : DyckEmbeds small large) :
    DyckEmbeds (leftWords + small) (leftWords + large) := by
  have lifted := dyckEmbeds_context
    (DyckContext.siblings leftWords 0 DyckContext.hole) h
  simpa only [DyckContext.plug, add_zero] using lifted

/-- Contractions in the two balanced-word arguments can be combined. -/
theorem dyckEmbeds_add {small1 large1 small2 large2 : DyckWord}
    (h1 : DyckEmbeds small1 large1) (h2 : DyckEmbeds small2 large2) :
    DyckEmbeds (small1 + small2) (large1 + large2) := by
  exact dyckEmbeds_trans
    (dyckEmbeds_append_left small1 h2)
    (dyckEmbeds_append_right large2 h1)

/-- Erasing one top-level pair is an ordinary Dyck contraction. -/
theorem dyckEmbeds_remove (leftWords middle suffix : DyckWord) :
    DyckEmbeds (leftWords + middle + suffix)
      (leftWords + middle.nest + suffix) := by
  apply Relation.ReflTransGen.single
  exact ⟨DyckContext.siblings leftWords suffix DyckContext.hole,
    middle, rfl, rfl⟩

/-- Soundness of the paper's *printed* recursive containment relation.
Inclusion into operational pair-deletion containment follows without
identifying the two relations by definition. -/
theorem PrintedContains.toDyckEmbeds {small large : DyckWord}
    (h : PrintedContains small large) : DyckEmbeds small large := by
  induction h with
  | refl word => exact Relation.ReflTransGen.refl
  | remove s1 s2 s3 t1 t2 t3 h1 h2 h3 ih1 ih2 ih3 =>
      have h12 := dyckEmbeds_add ih1 ih2
      have h123 := dyckEmbeds_add h12 ih3
      exact dyckEmbeds_trans h123 (dyckEmbeds_remove t1 t2 t3)

/-- Consequently every printed containment witness yields a genuine
root-preserving ordered-tree embedding after decoding. -/
theorem PrintedContains.toTreeEmbedding {small large : DyckWord}
    (h : PrintedContains small large) :
    Embeds (decodeDyck small) (decodeDyck large) := by
  exact dyckEmbeds_decodeDyck (PrintedContains.toDyckEmbeds h)

namespace DyckContext

/-- The number of pairs contributed by the fixed parts of a context. -/
def semilengthOverhead : DyckContext → Nat
  | .hole => 0
  | .siblings leftWords suffix inner =>
      leftWords.semilength + suffix.semilength + inner.semilengthOverhead
  | .nested inner => inner.semilengthOverhead + 1

/-- Substitution into a context adds a constant number of Dyck pairs. -/
theorem semilength_plug (ctx : DyckContext) (word : DyckWord) :
    (ctx.plug word).semilength =
      word.semilength + ctx.semilengthOverhead := by
  induction ctx with
  | hole => simp [DyckContext.plug, semilengthOverhead]
  | siblings leftWords suffix inner ih =>
      simp only [DyckContext.plug, semilengthOverhead,
        DyckWord.semilength_add, ih]
      omega
  | nested inner ih =>
      simp only [DyckContext.plug, semilengthOverhead,
        DyckWord.semilength_nest, ih]
      omega

end DyckContext

/-- A one-pair contraction strictly decreases Dyck semilength. -/
theorem dyckContractStep_semilength {before after : DyckWord}
    (step : DyckContractStep before after) :
    after.semilength < before.semilength := by
  rcases step with ⟨ctx, interior, hb, ha⟩
  rw [hb, ha]
  simp only [DyckContext.semilength_plug, DyckWord.semilength_nest]
  omega

/-- Dyck contraction closure cannot increase the number of pairs. -/
theorem dyckEmbeds_semilength_le {small large : DyckWord}
    (h : DyckEmbeds small large) :
    small.semilength ≤ large.semilength := by
  unfold DyckEmbeds at h
  induction h with
  | refl => exact Nat.le_refl _
  | tail hprefix hstep ih =>
      have hStrict := dyckContractStep_semilength hstep
      omega

/-- A concrete operational contraction used by the finite counterexample:
the root's only child loses one of its two outgoing leaf edges. -/
theorem branching_example_contractStep :
    ContractStep
      (.node [.node [singleton, singleton]])
      (.node [.node [singleton]]) := by
  have inner :
      ContractStep (.node [singleton, singleton]) (.node [singleton]) := by
    simpa [singleton, children] using
      (ContractStep.atRoot [] [singleton] singleton)
  simpa using (ContractStep.below [] [] inner)

/-- The corresponding encoded words are related by actual pair deletion. -/
theorem branching_example_dyckEmbeds :
    DyckEmbeds
      (encodeDyck (.node [.node [singleton]]))
      (encodeDyck (.node [.node [singleton, singleton]])) := by
  exact embeds_encodeDyck (embeds_of_step branching_example_contractStep)

end OrderedTree
end SubtreeProofs.Paper2004

end
