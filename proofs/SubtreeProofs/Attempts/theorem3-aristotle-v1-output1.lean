/-
Helper lemma: If treeLeaves x = 1, then S x ⊆ R x.
-/
theorem lemma_subset_R [LozanoContextFull] (x : BSeq) (h : treeLeavesOfSeq x = 1) :
    S x ⊆ R x := by
      have := @S_subset_R_of_treeLeaves_eq_one;
      contrapose! this;
      refine' ⟨ _, x, h, this ⟩

/-
Prove `treeLeaves_add_of_ne_nil` using `forestLeaves_add`.
-/
theorem treeLeaves_add_of_ne_nil (x y : BSeq) (hx : x ≠ BSeq.nil) :
    treeLeavesOfSeq (x + y) = treeLeavesOfSeq x + forestLeavesOfSeq y := by
      convert treeLeaves_eq_forestLeaves_of_ne_nil _ _ using 1;
      · convert treeLeaves_cons x y using 1;
        rw [ forestLeaves_add, treeLeaves_eq_forestLeaves_of_ne_nil x hx ];
      · cases x <;> cases y <;> tauto

/-
Prove that `nil` is always in `R x` and `S x`.
-/
theorem nil_mem_R [LozanoContextFull] (x : BSeq) : BSeq.nil ∈ R x := by
  -- By induction on the semilen of x, we can show that BSeq.nil is in R x for any x.
  induction' k : BSeq.semilen x using Nat.strong_induction_on with k ih generalizing x;
  cases x;
  · exact ‹LozanoContextFull›.R_nil.symm ▸ Finset.mem_singleton_self _;
  · rename_i x y;
    rename_i h;
    rename_i h';
    rw [ h'.R_cons ];
    simp +zetaDelta at *;
    convert ih _ _ _ rfl;
    rw [ ← k ];
    rw [ semilen_append ] ; norm_num

theorem nil_mem_S [LozanoContextFull] (x : BSeq) : BSeq.nil ∈ S x := by
  -- By induction on the semilen of x, we can show that BSeq.nil is in S x for any x.
  induction' k : BSeq.semilen x using Nat.strong_induction_on with k ih generalizing x;
  cases' x with x y;
  · exact ‹LozanoContextFull›.S_nil.symm ▸ Finset.mem_singleton_self _;
  · -- By definition of $S$, we know that $BSeq.nil \in S (x + y)$.
    have h_nil_in_S_xy : BSeq.nil ∈ (‹LozanoContextFull›.S (x + y)) := by
      apply ih (BSeq.semilen (x + y));
      · rw [ ← k ];
        rw [ BSeq.semilen_cons, semilen_append ] ; simp +arith +decide;
      · rfl;
    have := ‹LozanoContextFull›.S_cons_def x y; aesop;

/-
Prove `S (cons a b) = R a ∪ S b` when `a` is linear.
-/
theorem lemma_S_cons_linear_of_treeLeaves_eq_one [LozanoContextFull] (a b : BSeq) (ha : treeLeavesOfSeq a = 1) :
    S (BSeq.cons a b) = R a ∪ S b := by
      induction' a with u v hu hv generalizing b;
      · rename_i h;
        convert h.S_cons_def BSeq.nil b using 1;
      · by_cases h : v = BSeq.nil <;> simp_all +decide [ treeLeaves_cons ];
        · -- By the induction hypothesis, we know that S (cons u nil) = R u ∪ S nil.
          have h_ind : ‹LozanoContextFull›.S (BSeq.cons u BSeq.nil) = ‹LozanoContextFull›.R u ∪ ‹LozanoContextFull›.S BSeq.nil := by
            exact hu _;
          convert congr_arg ( fun s => ‹LozanoContextFull›.R ( BSeq.cons u BSeq.nil ) ∪ s ) ( hu b ) using 1;
          · convert ‹LozanoContextFull›.S_cons_def ( BSeq.cons u BSeq.nil ) b using 1;
          · ext x; by_cases hx : x ∈ ‹LozanoContextFull›.R u <;> simp +decide [ hx ] ;
            have := ‹LozanoContextFull›.R_cons u BSeq.nil; simp_all +decide [ Finset.ext_iff ] ;
            rw [ show u + BSeq.nil = u from by
                  -- By definition of append, we have u + BSeq.nil = u.
                  have h_append_nil : ∀ u : BSeq, u + BSeq.nil = u := by
                    intro u; exact (by
                    induction' u with u v hu hv generalizing b;
                    · rfl;
                    · exact congr_arg ( fun x => BSeq.cons u x ) ( hv v ));
                  exact h_append_nil u ] ; aesop;
        · contrapose! ha;
          exact ne_of_gt ( lt_add_of_pos_of_le ( Nat.pos_of_ne_zero ( by
            exact ne_of_gt ( ‹LozanoContextFull›.treeLeaves_pos u ) ) ) ( Nat.one_le_iff_ne_zero.mpr ( by
            exact ne_of_gt ( by linarith [ treeLeaves_eq_forestLeaves_of_ne_nil v h, ‹LozanoContextFull›.treeLeaves_pos v ] ) ) ) )

/-
Decomposition lemma for S(cons (cons a b) nil).
-/
theorem lemma_S_cons_nil_decomp [LozanoContextFull] (a b : BSeq) :
    S (BSeq.cons (BSeq.cons a b) BSeq.nil) = insert (BSeq.cons a b) (R a ∪ S (BSeq.cons (a + b) BSeq.nil)) := by
      convert Set.ext _;
      rotate_left;
      exact BSeq;
      exact { x | x ∈ ( ‹LozanoContextFull›.R ( a.cons b ) ∪ ‹LozanoContextFull›.S ( ( a.cons b ) + BSeq.nil ) ) };
      exact { x | x ∈ ‹LozanoContextFull›.R a ∪ ‹LozanoContextFull›.S ( ( a + b ).cons BSeq.nil ) ∪ { a.cons b } };
      · have := ‹LozanoContextFull›.R_cons a b; have := ‹LozanoContextFull›.S_cons_def a b; simp_all +decide [ Set.ext_iff ] ;
        have := ‹LozanoContextFull›.R_cons ( a + b ) BSeq.nil; have := ‹LozanoContextFull›.S_cons_def ( a + b ) BSeq.nil; simp_all +decide [ Set.ext_iff ] ;
        simp_all +decide [ show a.cons b + BSeq.nil = a.cons b from by
                            -- By definition of addition for BSeq, adding nil to any sequence results in the sequence itself.
                            have h_add_nil : ∀ x : BSeq, x + BSeq.nil = x := by
                              intro x; exact (by
                              induction' x with x y ihx ihy;
                              · rfl;
                              · -- By definition of BSeq.append, we have BSeq.cons x y + BSeq.nil = BSeq.cons x (y + BSeq.nil).
                                have h_append_cons : BSeq.cons x y + BSeq.nil = BSeq.cons x (y + BSeq.nil) := by
                                  exact?;
                                rw [h_append_cons, ihy]);
                            exact h_add_nil _ ];
        rw [ show a + b + BSeq.nil = a + b from by
              -- By definition of BSeq.append, appending BSeq.nil to any sequence x results in x itself.
              have h_append_nil : ∀ x : BSeq, x + BSeq.nil = x := by
                intro x; exact (by
                induction' x with x y ihx ihy;
                · rfl;
                · -- By definition of BSeq.append, we have BSeq.cons x y + BSeq.nil = BSeq.cons x (y + BSeq.nil).
                  have h_append_cons : BSeq.cons x y + BSeq.nil = BSeq.cons x (y + BSeq.nil) := by
                    exact?;
                  rw [h_append_cons, ihy]);
              exact h_append_nil _ ] ; aesop;
      · simp +decide [ Set.ext_iff, Finset.ext_iff ];
        exact ⟨ fun h => by have := ‹LozanoContextFull›.S_cons_def ( a.cons b ) BSeq.nil; aesop, fun h => by have := ‹LozanoContextFull›.S_cons_def ( a.cons b ) BSeq.nil; aesop ⟩

/-
Prove `x + nil = x` for BSeq.
-/
theorem add_nil (x : BSeq) : x + BSeq.nil = x := by
  -- We'll use induction on x to prove that x + BSeq.nil = x.
  induction' x with x ih;
  · rfl;
  · -- By definition of addition for BSeq, we have x.cons ih + BSeq.nil = x.cons (ih + BSeq.nil).
    have h_add : x.cons ih + BSeq.nil = x.cons (ih + BSeq.nil) := by
      exact?;
    aesop

/-
Prove `S (cons x nil) = R x ∪ S x`.
-/
theorem S_cons_nil_eq [LozanoContextFull] (x : BSeq) :
    S (BSeq.cons x BSeq.nil) = R x ∪ S x := by
  simp [S_cons_def, add_nil]
