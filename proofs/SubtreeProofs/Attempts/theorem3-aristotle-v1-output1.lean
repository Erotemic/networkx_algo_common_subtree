theorem inter_cons_nil_eq_R [LozanoContextFull] (u : BSeq) :
    R (BSeq.cons u BSeq.nil) ∩ S (BSeq.cons u BSeq.nil) = R u := by
      -- By definition of $R$ and $S$, we know that $R (u.cons BSeq.nil) = insert (u.cons BSeq.nil) (R u)$ and $S (u.cons BSeq.nil) = R u ∪ S (u.cons BSeq.nil)$.
      have hR : (‹LozanoContextFull›.R (u.cons BSeq.nil)) = insert (u.cons BSeq.nil) (‹LozanoContextFull›.R u) := by
        convert ( ‹LozanoContextFull›.R_cons u BSeq.nil ) using 1;
        -- By definition of $+$, we have $u + BSeq.nil = u$.
        have h_append_nil : u + BSeq.nil = u := by
          -- By definition of append, we know that u + BSeq.nil = u for any BSeq u.
          induction' u with u ih;
          · rfl;
          · -- By definition of append, we know that u.cons ih + BSeq.nil = u.cons (ih + BSeq.nil).
            have h_append_cons : u.cons ih + BSeq.nil = u.cons (ih + BSeq.nil) := by
              exact?;
            aesop
        rw [h_append_nil]
      have hS : (‹LozanoContextFull›.S (u.cons BSeq.nil)) = (‹LozanoContextFull›.R u) ∪ (‹LozanoContextFull›.S (u.cons BSeq.nil)) := by
        -- By definition of $S$, we know that $S (u.cons BSeq.nil) = R u ∪ S (u.cons BSeq.nil)$.
        apply Eq.symm; exact (by
          have := ‹LozanoContextFull›.S_cons_def u BSeq.nil;
          aesop ( simp_config := { singlePass := true } ) ;)
      simp_all +decide [ Finset.ext_iff ];
      -- If $a$ is in $R(u + \text{nil})$ and $S(u + \text{nil})$, then by $hR$, $a$ must be either $u + \text{nil}$ or in $R(u)$. But if $a$ is $u + \text{nil}$, then by $hS$, $a$ would also be in $S(u + \text{nil})$, which is true. However, if $a$ is in $R(u)$, then by $hS$, $a$ is in $S(u + \text{nil})$, which is also true. So the forward direction holds.
      intros a
      constructor
      intro h
      obtain ⟨haR, haS⟩ := h
      have haR' : a = u.cons BSeq.nil ∨ a ∈ ‹LozanoContextFull›.R u := by
        exact haR
      have haS' : a ∈ ‹LozanoContextFull›.S (u.cons BSeq.nil) := by
        assumption
      have haR'' : a ∈ ‹LozanoContextFull›.R u := by
        cases haR' <;> simp_all +decide [ Finset.ext_iff ];
        -- Since $u.cons BSeq.nil \in S (u.cons BSeq.nil)$ and $S (u.cons BSeq.nil) = R u \cup S (u.cons BSeq.nil)$, it follows that $u.cons BSeq.nil \in R u$.
        have h_contra : u.cons BSeq.nil ∈ (‹LozanoContextFull›.R u) ∪ (‹LozanoContextFull›.S (u.cons BSeq.nil)) := by
          exact Finset.mem_union_right _ haS
          skip
        generalize_proofs at *; (
        simp +zetaDelta at *; (
        -- Since $u.cons BSeq.nil$ is in $S (u.cons BSeq.nil)$ and $S (u.cons BSeq.nil)$ is a subset of $R u ∪ S (u.cons BSeq.nil)$, it follows that $u.cons BSeq.nil$ must be in $R u$.
        apply Or.resolve_right h_contra; exact (by
        intro h; have := @S_mem_semilen_lt; simp_all +decide ;
        -- Apply the hypothesis `this` to `u.cons BSeq.nil` and derive the contradiction.
        have := @this (‹LozanoContextFull›) (u.cons BSeq.nil) (by
        exact ne_of_apply_ne ( fun x => x ) ( by simp +decide )) (u.cons BSeq.nil) h; simp_all +decide [ BSeq.semilen_cons ] ;)
        skip))
      exact haR'';
      exact fun ha => ⟨ Or.inr ha, hS a ha ⟩

def isLinear : BSeq → Bool
  | BSeq.nil => true
  | BSeq.cons u v => match v with
    | BSeq.nil => isLinear u
    | _ => false

