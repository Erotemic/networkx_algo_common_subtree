  | BSeq.nil => {BSeq.nil}
  | BSeq.cons x y => insert (BSeq.cons x y) (R_comp (x + y))
termination_by x => BSeq.semilen x
decreasing_by
  all_goals
    simp_wf
    try rw [semilen_append]
    try rw [BSeq.semilen_cons]
    omega

