theorem S_mem_semilen_lt [LozanoContextFull] (x : BSeq) (hx : x ≠ BSeq.nil) :
    ∀ z ∈ S x, BSeq.semilen z < BSeq.semilen x := by
  induction x using BSeq.rec with
  | nil => contradiction
  | cons u v IHu IHv =>
    intro z hz
    rw [LozanoContext.S_cons_def] at hz
    rcases Finset.mem_union.mp hz with h_Ru | h_Suv
    · -- z ∈ R u
      have : BSeq.semilen z ≤ BSeq.semilen u := R_mem_semilen_le u z h_Ru
      calc BSeq.semilen z ≤ BSeq.semilen u := this
        _ < BSeq.semilen u + BSeq.semilen v + 1 := by linarith
        _ = BSeq.semilen (BSeq.cons u v) := by simp
    · -- z ∈ S (u + v)
      -- We need |z| < |cons u v|.
      -- If u+v != nil, then |z| < |u+v| = |u| + |v| < |cons u v|.
      -- If u+v = nil, S(u+v) = {nil}, z=nil, 0 < |cons u v|.
      by_cases huv : u + v = BSeq.nil
      · rw [huv, LozanoContextFull.S_nil] at h_Suv
        have : z = BSeq.nil := Finset.mem_singleton.mp h_Suv
        rw [this, BSeq.semilen_nil, BSeq.semilen_cons]
        linarith
      · have : BSeq.semilen z < BSeq.semilen (u + v) := by
          -- We need the IH for (u+v). But structural induction on x doesn't give IH for (u+v).
          -- We need strong induction on semilen.
          -- Or we can prove this lemma by strong induction on semilen x.
          -- By the definition of $S$, if $z \in S (u + v)$, then $z \in R (u + v)$ or $z \in S (u + v)$.
          apply (‹LozanoContextFull›.lemma5 u v) |> fun h => by
            cases eq_or_ne u BSeq.nil <;> cases eq_or_ne v BSeq.nil <;> simp_all +decide [ Set.subset_def ];
            · exact?;
            · cases h z h_Suv <;> simp_all +decide [ LozanoContextFull.S_nil ];
              · rw [ semilen_append ] ; aesop;
              · cases u <;> simp_all +decide [ BSeq.semilen ];
                exact Nat.succ_pos _;
            · cases h z h_Suv <;> simp_all +decide [ semilen_append ];
              · exact lt_add_of_lt_of_nonneg ( IHu _ ‹_› ) ( Nat.zero_le _ );
              · exact lt_of_lt_of_le ( IHv _ ‹_› ) ( Nat.le_add_left _ _ )
        rw [semilen_append] at this
        rw [BSeq.semilen_cons]
        linarith

