        intro n x hx z hz; induction' n using Nat.strong_induction_on with n ih generalizing x z; rcases x with ( _ | ⟨ u, v ⟩ ) <;> simp_all +decide ;
        · have := ‹LozanoContextFull›.R_nil; aesop;
        · -- By definition of $R$, we know that $R (u.cons v) = insert (u.cons v) (R (u + v))$ and $R (u + v)$ is a subset of sequences with semilen at most $(u + v).semilen$.
          have hR_uv : ∀ z ∈ (‹LozanoContextFull›.R (u + v)), z.semilen ≤ (u + v).semilen := by
            apply ih (BSeq.semilen (u + v)) (by
            rw [ ← hx ];
            rw [ semilen_append ] ; simp +arith +decide) (u + v) (by
            rfl);
          simp_all +decide [ LozanoContextFull.R_cons ];
          rcases hz with ( rfl | hz ) <;> [ exact hx ▸ by simp +arith +decide; ; exact le_trans ( hR_uv _ hz ) ( by simp +arith +decide [ ← hx, semilen_append ] ) ] ;
      exact h_ind _ _ rfl;
    -- By definition of $R$, we know that $z$ is either $u.cons v$ or in $R (u + v)$.
