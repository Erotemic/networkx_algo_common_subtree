      exact?;
    -- By definition of $R$, we know that $R (u + v)$ contains sequences whose semilen is at most semilen (u + v).
    have hR_uv : ∀ z ∈ (‹LozanoContextFull›.R (u + v)), z.semilen ≤ (u + v).semilen := by
      -- By induction on the length of $u + v$, we can show that $R (u + v)$ is a subset of sequences with semilen at most $(u + v).semilen$.
