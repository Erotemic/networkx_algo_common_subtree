def slack (x : BSeq) : Nat :=
  if isLinear x then 0 else BSeq.semilen x - 2

theorem lemma7_strong_algebra_nonlinear [LozanoContext] (u v : BSeq) (hu : ¬isLinear u) :
    2 * BSeq.semilen u + BSeq.semilen v + 1 - slack u - slack v ≤
    BSeq.semilen u * treeLeavesOfSeq v + BSeq.semilen v * treeLeavesOfSeq u + treeLeavesOfSeq u + treeLeavesOfSeq v := by
      have h_slack_bounds : 1 ≤ BSeq.semilen u ∧ 2 ≤ treeLeavesOfSeq u ∧ 0 ≤ BSeq.semilen v ∧ 1 ≤ treeLeavesOfSeq v := by
        have h_subst : ∀ x : BSeq, ¬isLinear x → 1 ≤ BSeq.semilen x ∧ 2 ≤ treeLeavesOfSeq x := by
          intro x hx
          induction' x with x ih;
          · contradiction;
          · cases ih <;> cases x <;> simp_all! +arith +decide;
            · rename_i k hk;
              cases k <;> simp_all +arith +decide;
              · exact?;
              · exact?;
            · rename_i k hk₁ hk₂;
              rename_i a b;
              cases a <;> cases k <;> simp_all +arith +decide;
              · rename_i a;
                linarith [ show 1 ≤ treeLeavesOfSeq a from by exact? , show 1 ≤ treeLeavesOfSeq b from by exact? ];
              · linarith;
              · linarith [ show 0 ≤ treeLeavesOfSeq b from Nat.zero_le _ ];
              · grind;
        exact ⟨ h_subst u hu |>.1, h_subst u hu |>.2, Nat.zero_le _, by exact? ⟩;
      unfold slack;
      rcases k : treeLeavesOfSeq u with ( _ | _ | k ) <;> rcases l : treeLeavesOfSeq v with ( _ | _ | l ) <;> simp_all +arith +decide;
      · grind;
      · grind

/-
Search for a counterexample to Lemma 7 up to semilength 8 using iterative generation to avoid recursion issues.
-/
def generateBSeqs (maxN : Nat) : Array (List BSeq) := Id.run do
  let mut arr : Array (List BSeq) := Array.mkArray (maxN + 1) []
  arr := arr.set! 0 [BSeq.nil]
  for n in [1:maxN+1] do
    let mut seqs : List BSeq := []
    -- We want semilen = n.
    -- cons x y has semilen = semilen x + semilen y + 1.
    -- Let k = semilen x. Then semilen y = n - 1 - k.
    -- k ranges from 0 to n - 1.
    for k in [0:n] do
      let lefts := arr.get! k
      let rights := arr.get! (n - 1 - k)
      for x in lefts do
        for y in rights do
          seqs := (BSeq.cons x y) :: seqs
    arr := arr.set! n seqs
  return arr

def check_inequality (x : BSeq) : Bool :=
  (S_comp_v18 x).card ≤ BSeq.semilen x * treeLeavesOfSeq x + 1

def check_slack_additive (x : BSeq) : Bool :=
  (S_comp_v18 x).card ≤ BSeq.semilen x * treeLeavesOfSeq x + BSeq.semilen x + 1

def check_slack_factor (x : BSeq) : Bool :=
  (S_comp_v18 x).card ≤ BSeq.semilen x * (treeLeavesOfSeq x + 1) + 1

def findCounterexample (maxN : Nat) : String := Id.run do
  let allSeqs := generateBSeqs maxN
  for n in [0:maxN+1] do
    for x in allSeqs.get! n do
      if ¬ check_inequality x then
        let s_card := (S_comp_v18 x).card
        let rhs := BSeq.semilen x * treeLeavesOfSeq x + 1
        let slack_add := check_slack_additive x
        let slack_fac := check_slack_factor x
        return s!"Counterexample found at n={n}: {repr x} | S_card={s_card} | RHS={rhs} | SlackAdd={slack_add} | SlackFac={slack_fac}"
  return "No counterexample found"

#eval! findCounterexample 8

