def slack (x : BSeq) : Nat :=
  if isLinear x then 0 else BSeq.semilen x - 2

theorem lemma7_strong_algebra_nonlinear [LozanoContext] (u v : BSeq) (hu : ¬isLinear u) :
    2 * BSeq.semilen u + BSeq.semilen v + 1 - slack u - slack v ≤
    BSeq.semilen u * treeLeavesOfSeq v + BSeq.semilen v * treeLeavesOfSeq u + treeLeavesOfSeq u + treeLeavesOfSeq v := by
      have h_slack_bounds : 1 ≤ BSeq.semilen u ∧ 2 ≤ treeLeavesOfSeq u ∧ 0 ≤ BSeq.semilen v ∧ 1 ≤ treeLeavesOfSeq v := by
        have h_subst : ∀ x : BSeq, ¬isLinear x → 1 ≤ BSeq.semilen x ∧ 2 ≤ treeLeavesOfSeq x := by
          intro x hx
          induction' x with x ih;
          · contradiction;
          · cases ih <;> cases x <;> simp_all! +arith +decide;
            · rename_i k hk;
              cases k <;> simp_all +arith +decide;
              · exact?;
              · exact?;
            · rename_i k hk₁ hk₂;
              rename_i a b;
              cases a <;> cases k <;> simp_all +arith +decide;
              · rename_i a;
                linarith [ show 1 ≤ treeLeavesOfSeq a from by exact? , show 1 ≤ treeLeavesOfSeq b from by exact? ];
              · linarith;
              · linarith [ show 0 ≤ treeLeavesOfSeq b from Nat.zero_le _ ];
              · grind;
        exact ⟨ h_subst u hu |>.1, h_subst u hu |>.2, Nat.zero_le _, by exact? ⟩;
      unfold slack;
      rcases k : treeLeavesOfSeq u with ( _ | _ | k ) <;> rcases l : treeLeavesOfSeq v with ( _ | _ | l ) <;> simp_all +arith +decide;
      · grind;
      · grind
