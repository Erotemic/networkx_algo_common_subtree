#eval! check_semilen_lt_treeLeaves (BSeq.cons BSeq.nil (BSeq.cons BSeq.nil BSeq.nil))
#eval! check_semilen_lt_treeLeaves (BSeq.cons (BSeq.cons BSeq.nil BSeq.nil) (BSeq.cons BSeq.nil BSeq.nil))

#eval! check_semilen_le_S_card BSeq.nil
#eval! check_semilen_le_S_card (BSeq.cons BSeq.nil BSeq.nil)
